# Next.js public site and server routes
NEXT_PUBLIC_SITE_URL=http://localhost:3000
CHAT_API_URL=http://127.0.0.1:8000
NEXT_PUBLIC_CHAT_API_URL=http://localhost:8000

# Sanity web reads and moderated testimonial writes
# Public reads do not use a read token.
NEXT_PUBLIC_SANITY_PROJECT_ID=
NEXT_PUBLIC_SANITY_DATASET=production
SANITY_API_WRITE_TOKEN=

# Sanity Studio
SANITY_STUDIO_PROJECT_ID=
SANITY_STUDIO_DATASET=production

# Contact form
RESEND_API_KEY=
CONTACT_FROM_EMAIL=
# Contact and testimonial alerts always go to profile.email in packages/content.
NEXT_PUBLIC_TURNSTILE_SITE_KEY=
TURNSTILE_SECRET_KEY=

# Consent-based analytics in Next.js
NEXT_PUBLIC_POSTHOG_KEY=
NEXT_PUBLIC_POSTHOG_HOST=https://eu.i.posthog.com

# FastAPI provider
OPENAI_API_KEY=
OPENAI_MODEL=gpt-5.5
OPENAI_TIMEOUT_SECONDS=90
OPENAI_MAX_RETRIES=2
OPENAI_REASONING_EFFORT=low
OPENAI_PLANNING_MAX_OUTPUT_TOKENS=2000
OPENAI_GENERATION_ATTEMPTS=2
# Optional global override; otherwise detail levels use 1200/2600/5200.
# OPENAI_MAX_OUTPUT_TOKENS=

# FastAPI browser, proxy and security configuration
CHAT_ALLOWED_ORIGINS=http://localhost:3000
CHAT_ALLOWED_HOSTS=localhost,127.0.0.1
CHAT_PUBLIC_ORIGIN=
KOYEB_PUBLIC_DOMAIN=
CHAT_COOKIE_SECURE=false
CHAT_ENABLE_HSTS=false

# FastAPI in-process limits
CHAT_MAX_CONCURRENT_GENERATIONS=2
CHAT_MAX_QUEUED_GENERATIONS=20
CHAT_MAX_REQUESTS_PER_MINUTE=12
CHAT_SESSION_TTL_SECONDS=3600
CHAT_MAX_SESSIONS=500
CHAT_MAX_TRACKED_CLIENTS=2000
CHAT_MAX_MONTHLY_REQUESTS=1000

# FastAPI chat content and optional Sanity chatSource reads
CHAT_CONTENT_TTL_SECONDS=300
SANITY_PROJECT_ID=
SANITY_DATASET=production

# Consent-based analytics in the inherited standalone chat client
POSTHOG_PUBLIC_KEY=
POSTHOG_HOST=https://eu.i.posthog.com

# Local and live test overrides
PLAYWRIGHT_BASE_URL=http://localhost:3000
PLAYWRIGHT_CHROMIUM_EXECUTABLE=
RUN_LIVE_OPENAI_TESTS=0
